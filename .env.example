# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# at least 32 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# monitoring systems send this as X-Alert-Key on POST /api/alerts (at least 24 characters)
ALERT_INGEST_KEY=
# public demo only: shows the demo accounts on the login page; seed with  python -m backend.app.seed --demo-incidents
DEMO_MODE=false
DEMO_PASSWORD=
# optional: server-side LLM for polishing postmortem summaries (never sent to the browser)
LLM_API_KEY=
